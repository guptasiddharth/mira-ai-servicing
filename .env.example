# Required — free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional model overrides
# Ordered failover chain (free tier quota is per model)
GEMINI_TEXT_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Kore
# Use async (NON_BLOCKING) function calling for slow tools in voice mode
VOICE_ASYNC_TOOLS=true
